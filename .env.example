# Copy to .env and fill in. .env is gitignored — never commit real secrets.

# --- Weather API (optional; falls back to synthetic data if unset) ---
OPENWEATHERMAP_API_KEY=

# --- Kafka (producer, from host) ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# Kafka as seen from inside the Spark container
KAFKA_BOOTSTRAP_SERVERS_INTERNAL=broker:29092

# --- Generator tuning ---
EMIT_INTERVAL_SECONDS=3

# --- AWS / S3 (Spark sink) ---
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_REGION=us-east-1
S3_BUCKET=spark-streaming-data
